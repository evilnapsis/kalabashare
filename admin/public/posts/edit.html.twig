{% extends "layouts/main.html.twig" %}

{% block title %}Editar Archivo{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Editar Archivo</h3>
  <a href="{{ base_url }}/posts" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form method="post" action="{{ base_url }}/posts/{{ post.id }}/update" enctype="multipart/form-data" class="row g-3">
      {{ csrf_field() }}
      <div class="col-md-3">
        <label class="form-label fw-semibold">Código</label>
        <input type="text" name="code" value="{{ post.code }}" class="form-control">
      </div>
      <div class="col-md-5">
        <label class="form-label fw-semibold">Título / Nombre *</label>
        <input type="text" name="name" value="{{ post.name }}" class="form-control" required>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Categoría *</label>
        <select name="category_id" class="form-select select2" required>
          {% for c in categories %}
          <option value="{{ c.id }}" {{ post.category_id == c.id ? 'selected' : '' }}>{{ c.name }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Autor (Cliente)</label>
        <select name="client_id" class="form-select select2">
          <option value="">-- Administrador --</option>
          {% for cl in clients %}
          <option value="{{ cl.id }}" {{ post.client_id == cl.id ? 'selected' : '' }}>{{ cl.name }} {{ cl.lastname }} ({{ cl.email }})</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Etiqueta / Formato</label>
        <input type="text" name="offer_txt" value="{{ post.offer_txt }}" class="form-control">
      </div>
      <div class="col-md-4">
        <label class="form-label fw-semibold">Enlace Externo</label>
        <input type="url" name="link" value="{{ post.link }}" class="form-control">
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Descripción</label>
        <textarea name="description" rows="4" class="form-control">{{ post.description }}</textarea>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Archivo Descargable (vacío para mantener)</label>
        <input type="file" name="file" class="form-control">
        {% if post.file %}
        <div class="small mt-1">Actual: <a href="storage/files/{{ post.file }}" target="_blank">{{ post.file }}</a></div>
        {% endif %}
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Imagen de Portada (vacío para mantener)</label>
        <input type="file" name="image" accept="image/*" class="form-control">
        {% if post.image %}
        <img src="storage/products/{{ post.image }}" class="mt-2 rounded border" style="max-height: 80px;">
        {% endif %}
      </div>
      <div class="col-12 d-flex gap-4">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="is_public" id="isPublic" {{ post.is_public ? 'checked' : '' }}>
          <label class="form-check-label" for="isPublic">Publicado</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="is_featured" id="isFeatured" {{ post.is_featured ? 'checked' : '' }}>
          <label class="form-check-label" for="isFeatured">Destacado en portada</label>
        </div>
      </div>
      <div class="col-12 text-end">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Actualizar</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
