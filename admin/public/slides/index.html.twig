{% extends "layouts/main.html.twig" %}

{% block title %}Sliders{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Sliders</h3>
  <a href="{{ base_url }}/slides/new" class="btn btn-primary">
    <i class="bi bi-plus-circle me-1"></i> Nuevo Slide
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Imagen</th>
            <th>Título</th>
            <th>Posición</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for s in slides %}
          <tr>
            <td>
              {% if s.image %}
              <img src="storage/slides/{{ s.image }}" alt="{{ s.title }}" style="height:50px; width:100px; object-fit:cover;" class="rounded border">
              {% endif %}
            </td>
            <td class="fw-semibold">{{ s.title ?: '(Sin título)' }}</td>
            <td><span class="badge bg-dark">{{ s.position }}</span></td>
            <td><span class="badge bg-{{ s.is_public ? 'success' : 'secondary' }}">{{ s.is_public ? 'Público' : 'Oculto' }}</span></td>
            <td class="text-end text-nowrap">
              <a href="{{ base_url }}/slides/{{ s.id }}/edit" class="btn btn-xs btn-outline-warning"><i class="bi bi-pencil"></i></a>
              <form method="post" action="{{ base_url }}/slides/{{ s.id }}/delete" class="d-inline confirm-post" data-confirm="¿Eliminar este slide?">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-xs btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
