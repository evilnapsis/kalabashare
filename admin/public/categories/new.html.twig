{% extends "layouts/main.html.twig" %}

{% block title %}Nueva Categoría{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Nueva Categoría</h3>
  <a href="{{ base_url }}/categories" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form method="post" action="{{ base_url }}/categories/create" class="row g-3">
      {{ csrf_field() }}
      <div class="col-md-6">
        <label class="form-label fw-semibold">Nombre *</label>
        <input type="text" name="name" class="form-control" required>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Slug (opcional, se genera automático)</label>
        <input type="text" name="short_name" class="form-control" placeholder="electronica">
      </div>
      <div class="col-12 d-flex gap-4">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="is_active" id="isActive" checked>
          <label class="form-check-label" for="isActive">Activa</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="in_menu" id="inMenu" checked>
          <label class="form-check-label" for="inMenu">Mostrar en menú superior</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="in_home" id="inHome">
          <label class="form-check-label" for="inHome">Destacar en inicio</label>
        </div>
      </div>
      <div class="col-12 text-end">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Guardar</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
