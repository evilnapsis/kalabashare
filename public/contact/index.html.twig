{% extends "layouts/main.html.twig" %}

{% block title %}Contacto | {{ site_config.general_main_title|default('KALABASHARE') }}{% endblock %}

{% block content %}
<div class="row g-4">
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-4">
        <h4 class="fw-bold mb-3">Información de Contacto</h4>
        <p class="text-muted">{{ site_config.about_text|default('Contáctanos para más información.') }}</p>
        <ul class="list-unstyled mt-4">
          {% if site_config.contact_address %}
          <li class="mb-3"><i class="bi bi-geo-alt text-primary me-2"></i> {{ site_config.contact_address }}</li>
          {% endif %}
          {% if site_config.contact_phone %}
          <li class="mb-3"><i class="bi bi-telephone text-primary me-2"></i> {{ site_config.contact_phone }}</li>
          {% endif %}
          {% if site_config.contact_email %}
          <li class="mb-3"><i class="bi bi-envelope text-primary me-2"></i> {{ site_config.contact_email }}</li>
          {% endif %}
        </ul>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h4 class="fw-bold mb-3">Envíanos un Mensaje</h4>
        <form method="post" action="{{ base_url }}/contact" class="row g-3">
          {{ csrf_field() }}
          <div class="col-md-6">
            <label class="form-label fw-semibold">Nombre *</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Correo Electrónico *</label>
            <input type="email" name="email" class="form-control" required>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Asunto</label>
            <input type="text" name="subject" class="form-control">
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Mensaje *</label>
            <textarea name="message" rows="4" class="form-control" required></textarea>
          </div>
          <div class="col-12 text-end">
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-send me-1"></i> Enviar Mensaje
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
