{% extends "layouts/main.html.twig" %}

{% block title %}{{ page_title }} | {{ site_config.general_main_title|default('KALABASHARE') }}{% endblock %}

{% block content %}
<div class="row g-4">
  <div class="col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="card-header bg-white fw-bold border-bottom py-3">
        <i class="bi bi-folder2 text-ks me-2"></i>Categorías
      </div>
      <div class="list-group list-group-flush">
        <a href="{{ base_url }}/posts" class="list-group-item list-group-item-action {{ active_slug == '' ? 'fw-bold bg-ks-soft' : '' }}">
          Todos los archivos
        </a>
        {% for c in categories %}
        <a href="{{ base_url }}/category/{{ c.short_name }}" class="list-group-item list-group-item-action {{ active_slug == c.short_name ? 'fw-bold bg-ks-soft' : '' }}">
          {{ c.name }}
        </a>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="col-lg-9">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0">{{ page_title }}</h4>
      <span class="badge bg-white text-dark border px-3 py-2 rounded-pill">{{ posts|length }} archivos</span>
    </div>

    <div class="d-flex flex-column gap-3">
      {% for p in posts %}
      <div class="ks-file-row p-3 d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
        <div class="d-flex align-items-start gap-3">
          <div class="ks-file-icon">
            {% if p.image %}
            <img src="admin/storage/products/{{ p.image }}" alt="{{ p.name }}" style="width:52px; height:52px; object-fit:cover; border-radius:12px;">
            {% else %}
            <i class="bi bi-file-earmark-arrow-down-fill"></i>
            {% endif %}
          </div>
          <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
              <a href="{{ base_url }}/post/{{ p.id }}" class="fw-bold text-dark text-decoration-none fs-6">{{ p.name }}</a>
              {% if p.offer_txt %}<span class="badge bg-ks-soft border">{{ p.offer_txt }}</span>{% endif %}
            </div>
            <p class="small text-muted mb-1">{{ p.description|length > 130 ? p.description|slice(0, 130) ~ '...' : p.description }}</p>
            <div class="text-muted" style="font-size: 12px;">
              <span class="me-3"><i class="bi bi-tag me-1"></i>{{ p.category_name }}</span>
              <span class="me-3"><i class="bi bi-person me-1"></i>{{ p.author_name }}</span>
              <span><i class="bi bi-download me-1"></i>{{ p.downloads }} descargas</span>
            </div>
          </div>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
          <a href="{{ base_url }}/post/{{ p.id }}" class="btn btn-outline-ks btn-sm rounded-pill px-3">Ver</a>
          {% if p.file or p.link %}
          <a href="{{ base_url }}/post/{{ p.id }}/download" class="btn btn-ks btn-sm rounded-pill px-3">
            <i class="bi bi-download me-1"></i> Descargar
          </a>
          {% endif %}
        </div>
      </div>
      {% else %}
      <div class="alert alert-light border">No se encontraron archivos para mostrar.</div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
