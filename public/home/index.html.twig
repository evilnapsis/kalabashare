{% extends "layouts/main.html.twig" %}

{% block content %}
<div class="ks-hero p-4 p-md-5 mb-4 shadow-sm">
  <div class="row align-items-center g-4">
    <div class="col-lg-8 mx-auto text-center">
      <span class="badge bg-white text-dark rounded-pill px-3 py-2 mb-3 fw-semibold">
        <i class="bi bi-cloud-check text-ks me-1"></i> Repositorio Digital Abierto
      </span>
      <h1 class="fw-bold display-6 mb-2">{{ site_config.general_main_title|default('KALABASHARE') }}</h1>
      <p class="opacity-75 mb-4">{{ site_config.about_text|default('Comparte y descarga documentos, plantillas, software y recursos digitales.') }}</p>

      <form method="get" action="{{ base_url }}/search" class="mb-3">
        <div class="input-group input-group-lg shadow-sm">
          <input type="search" name="q" class="form-control border-0" placeholder="Buscar software, PDF, plantillas, código...">
          <button class="btn btn-dark px-4 fw-semibold" type="submit">
            <i class="bi bi-search me-1"></i> Buscar
          </button>
        </div>
      </form>

      <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
        {% for cat in categories|slice(0, 6) %}
        <a href="{{ base_url }}/category/{{ cat.short_name }}" class="btn btn-sm btn-outline-light rounded-pill">
          {{ cat.name }}
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% if slides is not empty %}
<div id="homeCarousel" class="carousel slide mb-4 rounded-4 overflow-hidden shadow-sm" data-coreui-ride="carousel">
  <div class="carousel-inner">
    {% for s in slides %}
    <div class="carousel-item {{ loop.first ? 'active' : '' }}">
      <img src="admin/storage/slides/{{ s.image }}" class="d-block w-100" style="max-height: 300px; object-fit: cover;" alt="{{ s.title }}">
      {% if s.title %}
      <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-2">
        <h5 class="mb-0">{{ s.title }}</h5>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0"><i class="bi bi-stars text-ks me-2"></i>Archivos Destacados</h4>
  <a href="{{ base_url }}/posts" class="btn btn-outline-ks btn-sm rounded-pill px-3">Explorar todo <i class="bi bi-arrow-right ms-1"></i></a>
</div>

<div class="row g-3">
  {% for p in featured_posts %}
  <div class="col-md-6">
    <div class="ks-file-row p-3 h-100 d-flex align-items-start gap-3">
      <div class="ks-file-icon">
        {% if p.image %}
        <img src="admin/storage/products/{{ p.image }}" alt="{{ p.name }}" style="width:52px; height:52px; object-fit:cover; border-radius:12px;">
        {% else %}
        <i class="bi bi-file-earmark-zip-fill"></i>
        {% endif %}
      </div>
      <div class="flex-grow-1 min-w-0">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <a href="{{ base_url }}/post/{{ p.id }}" class="fw-bold text-dark text-decoration-none text-truncate d-block">
            {{ p.name }}
          </a>
          {% if p.offer_txt %}
          <span class="badge bg-ks-soft border flex-shrink-0">{{ p.offer_txt }}</span>
          {% endif %}
        </div>
        <div class="text-muted small mb-2">
          <span class="me-2"><i class="bi bi-tag me-1"></i>{{ p.category_name }}</span>
          <span class="me-2"><i class="bi bi-person me-1"></i>{{ p.author_name }}</span>
          <span><i class="bi bi-download me-1"></i>{{ p.downloads }}</span>
        </div>
        <p class="small text-muted mb-2">{{ p.description|length > 90 ? p.description|slice(0, 90) ~ '...' : p.description }}</p>
        <div class="d-flex gap-2">
          <a href="{{ base_url }}/post/{{ p.id }}" class="btn btn-outline-ks btn-sm rounded-pill px-3">Detalles</a>
          {% if p.file or p.link %}
          <a href="{{ base_url }}/post/{{ p.id }}/download" class="btn btn-ks btn-sm rounded-pill px-3">
            <i class="bi bi-download me-1"></i> Descargar
          </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% else %}
  <div class="col-12">
    <div class="alert alert-light border">No hay archivos destacados en este momento.</div>
  </div>
  {% endfor %}
</div>
{% endblock %}
