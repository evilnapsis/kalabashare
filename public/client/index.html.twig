{% extends "layouts/main.html.twig" %}

{% block title %}Mis Archivos | {{ site_config.general_main_title|default('KALABASHARE') }}{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0 fw-bold">Mis Archivos Compartidos</h3>
  <a href="{{ base_url }}/client/posts/new" class="btn btn-primary">
    <i class="bi bi-cloud-upload me-1"></i> Subir Archivo
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Descargas</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for p in posts %}
          <tr>
            <td>
              <a href="{{ base_url }}/post/{{ p.id }}" class="fw-semibold text-decoration-none">{{ p.name }}</a>
            </td>
            <td class="small">{{ p.category_name }}</td>
            <td><span class="badge bg-dark">{{ p.downloads }}</span></td>
            <td><span class="badge bg-{{ p.is_public ? 'success' : 'secondary' }}">{{ p.is_public ? 'Público' : 'Oculto' }}</span></td>
            <td class="text-end text-nowrap">
              <a href="{{ base_url }}/client/posts/{{ p.id }}/edit" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
              <form method="post" action="{{ base_url }}/client/posts/{{ p.id }}/delete" class="d-inline" onsubmit="return confirm('¿Eliminar este archivo?')">
                {{ csrf_field() }}
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          {% else %}
          <tr>
            <td colspan="5" class="text-center text-muted py-4">Aún no has compartido archivos.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
